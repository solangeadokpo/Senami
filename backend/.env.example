# Copy to .env and adjust. Every variable is validated at startup
# (src/config/env.validation.ts): the boot fails naming the faulty one.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api
API_DEFAULT_VERSION=1
# Comma-separated allow-list, e.g. https://app.senami.fr,https://www.senami.fr
CORS_ORIGINS=http://localhost:3001
# verbose | debug | log | warn | error
LOG_LEVEL=log

# Local database from docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgres://senami_app:senami_app@localhost:5433/senami
