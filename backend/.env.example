# Copy to .env and adjust. Every variable is validated at startup
# (src/config/env.validation.ts): the boot fails naming the faulty one.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api
API_DEFAULT_VERSION=1
# Comma-separated allow-list, e.g. https://app.senami.fr,https://www.senami.fr
CORS_ORIGINS=http://localhost:3001,http://app.localhost:3001
# verbose | debug | log | warn | error
LOG_LEVEL=log
# json | pretty. Default: pretty in development, json elsewhere.
# LOG_FORMAT=pretty

# Signs the access tokens: 32 characters at least. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-of-48-bytes
ACCESS_TOKEN_TTL_MINUTES=15
# Sliding: a mobile session expires this many days after its last use.
MOBILE_SESSION_DAYS=30
# Fixed: a back office session ends this many hours after the sign-in.
BACKOFFICE_SESSION_HOURS=12
# Encrypts the TOTP secrets: 32 random bytes in base64. Generate one with
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=change-me-to-32-random-bytes-in-base64-AAAA=

# Local database from docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgres://senami_app:senami_app@localhost:5433/senami

# Seeds (`pnpm db:seed`). Passwords: 12 characters at least, never committed.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-at-least-12
# SEED_SUPER_ADMIN_FIRST_NAME=Super
# SEED_SUPER_ADMIN_LAST_NAME=Admin
# Demo responsable and intervenant (demo level, never in production).
SEED_DEMO_PASSWORD=change-me-at-least-12
