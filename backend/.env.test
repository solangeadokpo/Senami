# Loaded by the e2e suite and `pnpm db:migrate:test`. Committed on purpose:
# it only points at the throwaway local test database.
NODE_ENV=test
# Origin the back office cookie tests send.
CORS_ORIGINS=http://localhost:3001
# Logs are discarded by createTestApp unless a test captures them.
LOG_LEVEL=log
DATABASE_URL=postgres://senami_app:senami_app@localhost:5433/senami_test
JWT_SECRET=test-only-secret-not-used-anywhere-else-0123456789
TOTP_ENCRYPTION_KEY=nAO1v6BRtOF4MJOsOfv5MLsMmKxTWxdjF82clhGVIEQ=
# The e2e suites replace the sender with an in-memory one: nothing is sent.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM_EMAIL=no-reply@senami.test
WEB_APP_URL=http://app.localhost:3001
