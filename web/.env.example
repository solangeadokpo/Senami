# Copy to .env and adapt. .env is never committed.

# The API, called by the Next.js server and through the /api rewrite.
API_URL=http://localhost:3000

# Public URLs, inlined in the browser bundle at build time.
# *.localhost resolves to this machine: no hosts file needed.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://app.localhost:3001
